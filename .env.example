# Sky-History Configuration
# Copy this file to .env and adjust values

# PostgreSQL connection string
# For Docker Compose, leave commented out (uses internal networking).
# For local development against a remote PostgreSQL:
#DATABASE_URL=postgres://skyhistory:skyhistory@skyhistory-db:5432/skyhistory?sslmode=disable

# PostgreSQL password (only used by docker-compose for the db container)
POSTGRES_PASSWORD=skyhistory

# GitHub personal access token (optional, recommended for higher rate limits)
GITHUB_TOKEN=

# GitHub repository to poll for releases
GITHUB_REPO=adsblol/globe_history_2026

# How often to check for new releases
POLL_INTERVAL=1h

# Number of days to backfill on first run (0 = only new releases)
BACKFILL_DAYS=0

# Number of concurrent file parser workers
PARSE_WORKERS=4

# Directory for downloaded release files (default: OS temp directory)
# TEMP_DIR=D:\skyhistory-data

# Keep downloaded files on disk to avoid re-downloading during development.
# Set to true to cache; files are reused if they already exist for a release tag.
KEEP_DOWNLOADS=false

# Custom tar1090/ultrafeeder URLs (comma-separated base URLs)
# Example: http://192.168.1.100:8080/tar1090,http://myreadsb.local
ULTRAFEEDER_URLS=

# Port the frontend is exposed on
FRONTEND_PORT=8080

# --- Live gap-fill collector -------------------------------------------------
# The collector polls approved feeders for readsb's aircraft.json and writes
# provisional flight rows covering the time since the last processed release.
# Feeders live in the database, not here: anyone can submit one through the UI,
# and it stays inert until you set feeders.enabled = TRUE by hand.

# MASTER SWITCH. Off by default. Until this is true the collector polls nothing,
# the /api/feeders endpoints are not registered at all, include_live is ignored,
# and the Feeders page and its setting do not appear in the UI.
# Set it on both the api and collector services.
ENABLE_LIVE_GAPFILL=false

# How often each feeder is polled.
COLLECTOR_POLL_INTERVAL=5s

# How long an aircraft may go unseen before its flight segment is closed.
COLLECTOR_SEGMENT_GAP=15m

# How often segments are written to the database. Open segments are written
# too, so an aircraft still in the air is searchable right away.
COLLECTOR_FLUSH_INTERVAL=30s

# How often the enabled-feeder list is re-read, so approving a feeder takes
# effect without restarting the collector.
COLLECTOR_FEEDER_RELOAD=1m

# Per-request timeouts when polling and when checking a submitted feeder.
COLLECTOR_FETCH_TIMEOUT=15s
FEEDER_PROBE_TIMEOUT=10s

# Secret keying the hash of a submitter's IP address, used only to rate limit
# submissions. Leave empty and a random one is generated per restart, which
# only weakens the 24-hour limit. Set it to any long random string.
SUBMIT_IP_SALT=

# Allow feeder URLs on private, loopback and link-local addresses.
#
# SECURITY: the submit endpoint makes this server fetch a URL chosen by whoever
# fills in the form. With this off, addresses that are not publicly routable are
# refused, which is what stops the form being used to probe your internal
# network. Only turn it on if the UI is NOT reachable by the public -- for
# instance when your feeders sit on the same Docker network as this stack.
ALLOW_PRIVATE_FEEDERS=false
